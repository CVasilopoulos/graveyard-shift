[
  {
    "name": "single GET request returns 200 with JSON body",
    "method": "GET",
    "url": "https://api.example.com/data",
    "respondWith": {
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "status": "ok",
        "data": [1, 2, 3]
      },
      "delayMs": 0
    }
  }
]
